{
    "manifest_version": 3,
    "name": "Messenger Batch Actions",
    "short_name": "Messenger Tools",
    "version": "1.1.0",
    "description": "Archive, mute, delete or leave many Messenger chats at once, on messenger.com and facebook.com/messages.",
    "homepage_url": "https://github.com/yvantot/messenger-batch-actions",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "background": {
        "service_worker": "js/background.js"
    },
    "action": {
        "default_popup": "html/index.html",
        "default_title": "Messenger Batch Actions"
    },
    "icons": {
        "16": "assets/icons/icon16.png",
        "32": "assets/icons/icon32.png",
        "48": "assets/icons/icon48.png",
        "128": "assets/icons/icon128.png"
    },
    "content_scripts": [
        {
            "js": [
                "js/shared/page-parts.js",
                "js/content/report.js",
                "js/content/parts.js",
                "js/content/chats.js",
                "js/content/actions.js",
                "js/content/main.js"
            ],
            "matches": [
                "https://www.messenger.com/*",
                "https://www.facebook.com/messages/*"
            ]
        }
    ]
}
